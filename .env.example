NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/japanese_learning?schema=public
AUTH_USERNAME=admin
# Default hash for "admin123" ($2b$10$7iWNjEdErD12hmTUfcOkk.UNs0g9fjQla/BZbvgnnC56cBAu2.2Aa)
AUTH_PASSWORD_HASH=$2b$10$7iWNjEdErD12hmTUfcOkk.UNs0g9fjQla/BZbvgnnC56cBAu2.2Aa
AUTH_TOKEN_SECRET=development_super_secret_jwt_key_at_least_32_chars_long
CORS_ORIGINS=http://localhost:3000
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=debug
SLOW_REQUEST_MS=1000
# Next.js Web public API URL (injected at build time; local development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Expo Mobile public API URL
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
