NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/japanese_learning?schema=public
AUTH_USERNAME=admin
# Generate a local bcrypt hash; never commit a real password/hash.
AUTH_PASSWORD_HASH=<generated-bcrypt-hash>
# Replace with a random value of at least 32 characters for local use.
AUTH_TOKEN_SECRET=<replace-with-at-least-32-random-characters>
CORS_ORIGINS=http://localhost:3000
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=debug
SLOW_REQUEST_MS=1000
# Next.js Web public API URL (injected at build time; local development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Expo Mobile public API URL
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
