datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum QuestionType {
  MULTIPLE_CHOICE_SINGLE
  READING_PASSAGE
  LISTENING_AUDIO
}

enum ContextType {
  TEXT
  AUDIO
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ImportType {
  FLASHCARD_SET
  EXAM
}

enum RecentLearningKind {
  FLASHCARD_SET
  EXAM
}

enum FlashcardScheduleState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum FlashcardReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model FlashcardSet {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  coverRef    String?   @map("cover_ref") @db.Text
  isFavorite  Boolean   @default(false) @map("is_favorite")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  cards Flashcard[]
  tags  FlashcardSetTag[]

  @@index([deletedAt])
  @@map("flashcard_sets")
}

model Flashcard {
  id        String    @id @default(uuid()) @db.Uuid
  setId     String    @map("set_id") @db.Uuid
  front     String    @db.Text
  back      String    @db.Text
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  fsrsState          FlashcardScheduleState @default(NEW) @map("fsrs_state")
  fsrsDueAt          DateTime               @default(now()) @map("fsrs_due_at") @db.Timestamptz(6)
  fsrsStability      Float?                 @map("fsrs_stability")
  fsrsDifficulty     Float?                 @map("fsrs_difficulty")
  fsrsElapsedDays    Int                    @default(0) @map("fsrs_elapsed_days")
  fsrsScheduledDays  Int                    @default(0) @map("fsrs_scheduled_days")
  fsrsLearningSteps  Int                    @default(0) @map("fsrs_learning_steps")
  fsrsReps           Int                    @default(0) @map("fsrs_reps")
  fsrsLapses         Int                    @default(0) @map("fsrs_lapses")
  fsrsLastReviewedAt DateTime?              @map("fsrs_last_reviewed_at") @db.Timestamptz(6)

  set        FlashcardSet         @relation(fields: [setId], references: [id], onDelete: Cascade)
  reviewLogs FlashcardReviewLog[]

  @@index([setId, position])
  @@index([deletedAt])
  @@index([deletedAt, fsrsDueAt])
  @@map("flashcards")
}

model FlashcardReviewLog {
  id              String                 @id @default(uuid()) @db.Uuid
  flashcardId     String                 @map("flashcard_id") @db.Uuid
  clientRequestId String                 @map("client_request_id") @db.VarChar(128)
  rating          FlashcardReviewRating
  stateBefore     FlashcardScheduleState @map("state_before")
  stateAfter      FlashcardScheduleState @map("state_after")
  reviewedAt      DateTime               @map("reviewed_at") @db.Timestamptz(6)
  dueAtBefore     DateTime               @map("due_at_before") @db.Timestamptz(6)
  dueAtAfter      DateTime               @map("due_at_after") @db.Timestamptz(6)
  elapsedDays     Int                    @map("elapsed_days")
  scheduledDays   Int                    @map("scheduled_days")
  learningSteps   Int                    @map("learning_steps")
  reps            Int                    @map("reps")
  lapses          Int                    @map("lapses")
  stability       Float?
  difficulty      Float?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, clientRequestId])
  @@index([flashcardId, reviewedAt])
  @@map("flashcard_review_logs")
}

model ExamFolder {
  id        String    @id @default(uuid()) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(255)
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   ExamFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ExamFolder[] @relation("FolderHierarchy")
  exams    Exam[]

  @@index([parentId, position])
  @@index([deletedAt])
  @@map("exam_folders")
}

model Exam {
  id               String    @id @default(uuid()) @db.Uuid
  folderId         String?   @map("folder_id") @db.Uuid
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  coverRef         String?   @map("cover_ref") @db.Text
  isFavorite       Boolean   @default(false) @map("is_favorite")
  timeLimitSeconds Int?      @map("time_limit_seconds")
  contentVersion   Int       @default(1) @map("content_version")
  shuffleQuestions Boolean   @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean   @default(false) @map("shuffle_options")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  folder      ExamFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
  bestResults ExamBestResult[]
  mistakes    ExamMistake[]
  contexts    QuestionContext[]
  tags        ExamTag[]

  @@index([folderId])
  @@index([deletedAt])
  @@map("exams")
}

model QuestionContext {
  id          String      @id @default(uuid()) @db.Uuid
  examId      String      @map("exam_id") @db.Uuid
  type        ContextType
  textContent String?     @map("text_content") @db.Text
  mediaRef    String?     @map("media_ref") @db.Text
  position    Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]

  @@index([examId, position])
  @@map("question_contexts")
}

model ExamQuestion {
  id        String       @id @default(uuid()) @db.Uuid
  examId    String       @map("exam_id") @db.Uuid
  contextId String?      @map("context_id") @db.Uuid
  type      QuestionType @default(MULTIPLE_CHOICE_SINGLE)
  content   String       @db.Text
  position  Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam     Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  context  QuestionContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  options  ExamOption[]
  mistakes ExamMistake[]

  @@index([examId, position])
  @@map("exam_questions")
}

model ExamOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  content    String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("exam_options")
}

model ExamAttempt {
  id                    String        @id @default(uuid()) @db.Uuid
  examId                String        @map("exam_id") @db.Uuid
  examVersion           Int           @map("exam_version")
  userKey               String        @default("primary_user") @map("user_key") @db.VarChar(255)
  startedAt             DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt             DateTime?     @map("expires_at") @db.Timestamptz(6)
  submittedAt           DateTime?     @map("submitted_at") @db.Timestamptz(6)
  status                AttemptStatus @default(IN_PROGRESS)
  score                 Decimal?      @db.Decimal(5, 2)
  correctCount          Int?          @map("correct_count")
  totalQuestions        Int           @map("total_questions")
  durationSeconds       Int?          @map("duration_seconds")
  questionOrderSnapshot Json?         @map("question_order_snapshot")
  optionOrderSnapshot   Json?         @map("option_order_snapshot")
  isPractice            Boolean       @default(false) @map("is_practice")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam    Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAttemptAnswer[]

  @@index([examId, userKey])
  @@map("exam_attempts")
}

model ExamMistake {
  id               String   @id @default(uuid()) @db.Uuid
  examId           String   @map("exam_id") @db.Uuid
  examVersion      Int      @map("exam_version")
  questionId       String   @map("question_id") @db.Uuid
  sourceAttemptId  String   @map("source_attempt_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, examVersion, questionId])
  @@index([examId, examVersion, updatedAt])
  @@map("exam_mistakes")
}

model ExamAttemptAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  isCorrect        Boolean? @map("is_correct")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_attempt_answers")
}

model ExamBestResult {
  id              String   @id @default(uuid()) @db.Uuid
  examId          String   @map("exam_id") @db.Uuid
  examVersion     Int      @map("exam_version")
  userKey         String   @default("primary_user") @map("user_key") @db.VarChar(255)
  bestScore       Decimal  @map("best_score") @db.Decimal(5, 2)
  correctCount    Int      @map("correct_count")
  totalQuestions  Int      @map("total_questions")
  durationSeconds Int?     @map("duration_seconds")
  attemptCount    Int      @default(1) @map("attempt_count")
  achievedAt      DateTime @default(now()) @map("achieved_at") @db.Timestamptz(6)
  lastAttemptAt   DateTime @default(now()) @map("last_attempt_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userKey, examId, examVersion])
  @@index([examId])
  @@map("exam_best_results")
}

model ImportSession {
  id                String     @id @default(uuid()) @db.Uuid
  type              ImportType
  payloadHash       String     @map("payload_hash") @db.VarChar(64)
  normalizedPayload Json       @map("normalized_payload")
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("import_sessions")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  flashcardSets FlashcardSetTag[]
  exams         ExamTag[]

  @@index([name])
  @@map("tags")
}

model FlashcardSetTag {
  setId     String   @map("set_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  set FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  tag Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([setId, tagId])
  @@index([tagId])
  @@map("flashcard_set_tags")
}

model ExamTag {
  examId    String   @map("exam_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([examId, tagId])
  @@index([tagId])
  @@map("exam_tags")
}

model RecentLearning {
  id             String             @id @default(uuid()) @db.Uuid
  userKey        String             @default("primary_user") @map("user_key") @db.VarChar(255)
  kind           RecentLearningKind
  entityId       String             @map("entity_id") @db.Uuid
  lastAccessedAt DateTime           @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // entityId is intentionally polymorphic: the API validates the target and
  // removes deleted/invalid content when it builds the bounded read response.
  @@unique([userKey, kind, entityId])
  @@index([userKey, lastAccessedAt])
  @@map("recent_learning")
}
